{
    "version": "0.3.41",
    "description": "Transactional multi-file text editor for coding agents",
    "homepage": "https://github.com/kmoneil/hunk",
    "license": "Apache-2.0",
    "suggest": {
        "sh, for --verify and --try": "main/git"
    },
    "architecture": {
        "64bit": {
            "url": [
                "https://github.com/kmoneil/hunk/releases/download/v0.3.41/hunk-windows-amd64.exe#/hunk.exe",
                "https://github.com/kmoneil/hunk/releases/download/v0.3.41/hunk-skill.tar.gz#/skill.download"
            ],
            "hash": [
                "1daf842d633009633e74e05c04c4c49dd41ebda6ba3277b55695477b8f9197c7",
                "91e4c31ecc2d314cd003a4f630ff635cb25e66bb021dd2e5052ac1b62ea369cd"
            ]
        },
        "arm64": {
            "url": [
                "https://github.com/kmoneil/hunk/releases/download/v0.3.41/hunk-windows-arm64.exe#/hunk.exe",
                "https://github.com/kmoneil/hunk/releases/download/v0.3.41/hunk-skill.tar.gz#/skill.download"
            ],
            "hash": [
                "f16c51053114e2d3f2fb9ef96bbf01693cf307ad688d94241155495b1cc023d9",
                "91e4c31ecc2d314cd003a4f630ff635cb25e66bb021dd2e5052ac1b62ea369cd"
            ]
        }
    },
    "bin": "hunk.exe",
    "post_install": [
        "$claude = Join-Path $env:USERPROFILE '.claude\\skills'",
        "$agents = Join-Path $env:USERPROFILE '.agents\\skills'",
        "New-Item -ItemType Directory -Force -Path $claude, $agents | Out-Null",
        "& \"$env:SystemRoot\\System32\\tar.exe\" -xzf \"$dir\\skill.download\" -C $claude",
        "if ($LASTEXITCODE -ne 0) { throw \"tar could not extract hunk's skill into $claude\" }",
        "& \"$env:SystemRoot\\System32\\tar.exe\" -xzf \"$dir\\skill.download\" -C $agents",
        "if ($LASTEXITCODE -ne 0) { throw \"tar could not extract hunk's skill into $agents\" }"
    ],
    "notes": [
        "hunk's agent skill is in ~\\.claude\\skills\\hunk, the folder Claude Code reads, and",
        "~\\.agents\\skills\\hunk, the unified folder most other agents read. 'scoop update",
        "hunk' keeps both at the binary's version. 'scoop uninstall hunk' leaves them where",
        "they are.",
        "--verify and --try run their command with sh, which 'scoop install git' provides."
    ]
}
